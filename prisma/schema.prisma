generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Better Auth — core models (managed by the auth server)
// ─────────────────────────────────────────────────────────────

model User {
    id            String   @id @default(uuid())
    name          String
    email         String   @unique
    emailVerified Boolean  @default(false)
    image         String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    // stripe plugin
    stripeCustomerId String?

    sessions    Session[]
    accounts    Account[]
    members     Member[]
    invitations Invitation[]

    @@map("user")
}

model Session {
    id        String   @id @default(uuid())
    token     String   @unique
    expiresAt DateTime
    ipAddress String?
    userAgent String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // organization plugin
    activeOrganizationId String?

    @@map("session")
}

model Account {
    id                    String    @id @default(uuid())
    accountId             String
    providerId            String
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("account")
}

model Verification {
    id         String   @id @default(uuid())
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@map("verification")
}

// ─────────────────────────────────────────────────────────────
// Better Auth — organization plugin (multi-tenancy + RBAC)
// ─────────────────────────────────────────────────────────────

model Organization {
    id        String   @id @default(uuid())
    name      String
    slug      String?  @unique
    logo      String?
    metadata  String?
    createdAt DateTime @default(now())

    members     Member[]
    invitations Invitation[]

    @@map("organization")
}

model Member {
    id             String   @id @default(uuid())
    role           String   @default("member")
    createdAt      DateTime @default(now())

    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    userId         String
    user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([organizationId, userId])
    @@map("member")
}

model Invitation {
    id        String   @id @default(uuid())
    email     String
    role      String?
    status    String   @default("pending")
    expiresAt DateTime
    createdAt DateTime @default(now())

    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    inviterId      String
    inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

    @@map("invitation")
}

// ─────────────────────────────────────────────────────────────
// Better Auth — stripe plugin (subscriptions / billing)
// referenceId links a subscription to a user or an organization.
// ─────────────────────────────────────────────────────────────

model Subscription {
    id                   String    @id @default(uuid())
    plan                 String
    referenceId          String
    stripeCustomerId     String?
    stripeSubscriptionId String?
    stripeScheduleId     String?
    status               String    @default("incomplete")
    billingInterval      String?
    periodStart          DateTime?
    periodEnd            DateTime?
    trialStart           DateTime?
    trialEnd             DateTime?
    cancelAtPeriodEnd    Boolean?  @default(false)
    cancelAt             DateTime?
    canceledAt           DateTime?
    endedAt              DateTime?
    seats                Int?
    createdAt            DateTime  @default(now())
    updatedAt            DateTime  @updatedAt

    @@index([referenceId])
    @@map("subscription")
}

# Origin of the API server.
#
# Leave empty for the default setup: the web app calls same-origin `/api`,
# which Vite proxies to http://localhost:8000 in development and which your
# host/CDN should route to the API server in production.
#
# Set it only when the API is served from a different origin, e.g.
#   VITE_API_URL="https://api.example.com"
VITE_API_URL=""

    "lint": "oxlint",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "react-email": "^6.9.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@react-email/components": {
      "prismjs": ">=1.30.0"
    }
  }
}

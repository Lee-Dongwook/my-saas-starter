# ── Core ────────────────────────────────────────────────────────────────
# Product name shown in the UI (served to the web app via GET /api/config).
APP_NAME="SaaS Starter"

# Postgres connection string used by Prisma and the API server.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas?schema=public"

# Secret used by Better Auth to sign sessions. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"

# Public URL of the API (Better Auth base URL) and the web origin.
BETTER_AUTH_URL="http://localhost:8000"
WEB_ORIGIN="http://localhost:3000"
PORT=8000

# ── OAuth (optional) ────────────────────────────────────────────────────
# A provider is enabled only when BOTH id and secret are set.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stripe billing (optional) ───────────────────────────────────────────
# Billing is enabled only when BOTH the secret key and webhook secret are set.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""

# ── Email (optional) ────────────────────────────────────────────────────
# Without RESEND_API_KEY, transactional emails are logged to the console.
RESEND_API_KEY=""
EMAIL_FROM="SaaS Starter <onboarding@resend.dev>"
